# ── Partner access (downstream) ───────────────────────────────────────────────
# The key(s) you hand to partners. Generate with: openssl rand -hex 32
# Comma-separate for multiple partners (revoke = delete one + restart).
PARTNER_API_KEYS=

# ── Your OnlyChat tenant (stable CUIDs — grab from the SPA URL + /organization/me)
ONLYCHAT_ORG_ID=

# One OR many creators of the SAME OnlyChat account. Comma-separate for multiple.
# The partner picks one per call with ?creator=<id>; omitting it uses the FIRST.
ONLYCHAT_CREATOR_IDS=
# (legacy single-creator var, still honored if ONLYCHAT_CREATOR_IDS is empty)
# ONLYCHAT_CREATOR_ID=

# Optional friendly labels surfaced by GET /funnel/creators — "label:id,label2:id2"
# ONLYCHAT_CREATORS=emy:cuid_aaa,lina:cuid_bbb

# ── Upstream auth — pick ONE mode ─────────────────────────────────────────────
# Mode A (simple): paste a Bearer token sniffed from DevTools on app.only-chat.ai.
#   ⚠️ can rotate; if calls start 401-ing, re-sniff and update.
ONLYCHAT_TOKEN=

# Mode B (durable, recommended): leave ONLYCHAT_TOKEN empty and set these.
#   The service logs in, caches the ~30-min JWT, and auto-refreshes on 401.
ONLYCHAT_EMAIL=
ONLYCHAT_PASSWORD=

# ── Tuning (optional) ─────────────────────────────────────────────────────────
PORT=8787
UPSTREAM_CACHE_TTL_MS=60000      # memory-cache OnlyChat reads this long
MAX_BACKFILL_PER_CALL=40         # fans whose arrival is computed per /summary call (warm-up)

# Opt-in: expose fans' conversation transcripts via /funnel/fans/:id/messages.
# OFF by default (most sensitive data). Set to true to let the partner read messages.
EXPOSE_MESSAGES=false

# Opt-in: expose per-fan star totals via /funnel/revenue (no message bodies — just
# the revenue number per fan). OFF by default. Turn on so the partner can fire
# Meta Purchase events on star deltas. /funnel/match (opener-phrase attribution)
# needs no flag — it returns only fan_id ↔ phrase and never leaks message text.
EXPOSE_REVENUE=false
